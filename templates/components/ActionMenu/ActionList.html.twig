{% props
    ## bool Whether some items of the list open a submenu (`ItemGroup` sub-components).
    hasSubmenus = false,
%}

{% set css_class = html_classes(
    'dropdown-menu dropdown-menu-end',
    hasSubmenus ? 'dropdown-has-submenus',
) %}

<ul {{ attributes.defaults({class: css_class}) }}>
    {## The items of the list (`Item`, `ItemGroup`, `Header`, `Divider`, etc. sub-components). -#}
    <twig:block name="content"></twig:block>
</ul>
