{% props
    ## bool Whether some items of the list open a submenu (`ItemGroup` sub-components).
    hasSubmenus = false,
    ## 'start'|'end' The edge of the button that the menu is aligned to: 'start' opens the menu towards the end side (e.g. to the right) and 'end' towards the start side. If there's no room, the menu opens to the other side.
    align = 'start',
%}

{% set css_class = html_classes(
    'dropdown-menu',
    'end' == align ? 'dropdown-menu-end',
    hasSubmenus ? 'dropdown-has-submenus',
) %}

<ul {{ attributes.defaults({class: css_class}) }}>
    {## The items of the list (`Item`, `ItemGroup`, `Header`, `Divider`, etc. sub-components). -#}
    <twig:block name="content"></twig:block>
</ul>
