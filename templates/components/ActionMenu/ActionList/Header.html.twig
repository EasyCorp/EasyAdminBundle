{% props
    ## string|null The text of the header; the header is not rendered when both the label and the icon are empty.
    label = null,
    ## bool If true, the label is rendered without escaping its HTML contents.
    renderLabelRaw = false,
    ## string|null The name of the optional icon displayed before the label.
    icon = null,
    ## array Extra HTML attributes for the `<li>` element.
    htmlAttributes = {},
%}

{% set has_label = label is ea_is_not_empty %}
{% if has_label or icon is not empty %}
    <li {{ attributes.defaults({class: 'dropdown-header'}|merge(htmlAttributes)) }}>
        {%- if icon %}<twig:ea:Icon {{ ...attributes.nested('icon').defaults({name: icon}) }} /> {% endif -%}
        {%- if has_label -%}<span {{ attributes.nested('label') }}>{{ renderLabelRaw ? label|raw : label }}</span>{%- endif -%}
    </li>
{% endif %}
