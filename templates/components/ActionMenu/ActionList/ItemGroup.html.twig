{% props
    ## ActionGroupDto The action group rendered as a submenu (and its optional main action); required, even if it defaults to null.
    group = null,
    ## bool Internal: not used anymore (items without icon are aligned with CSS when other items of the menu have icons).
    showBlankIcons = true,
    ## EntityDto|null The entity which the actions of the group belong to.
    entity = null,
%}

{% set submenu %}
    <ul class="dropdown-menu">
        {% for subItem in group.items %}
            {% if subItem is iterable and subItem.type is defined %}
                {% if subItem.type == 'divider' %}
                    <twig:ea:ActionMenu:ActionList:Divider />
                {% elseif subItem.type == 'header' %}
                    <twig:ea:ActionMenu:ActionList:Header label="{{ subItem.content|trans }}" renderLabelRaw="true" />
                {% endif %}
            {% else %}
                {# subItem is an ActionDto #}
                <twig:ea:ActionMenu:ActionList:Item
                    class="{{ subItem.cssClass }} dropdown-item-variant-{{ subItem.color.value }}"
                    label="{{ subItem.label|trans }}" icon="{{ subItem.icon }}"
                    htmlAttributes="{{ subItem.htmlAttributes|ea_html_attrs }}"
                    url="{{ subItem.linkUrl }}" renderLabelRaw="true"
                    renderAsForm="{{ subItem.isRenderedAsForm }}" />
            {% endif %}
        {% endfor %}
    </ul>
{% endset %}

{% if group.hasMainAction and group.actions|length == 0 %}
    {# all the submenu actions can be hidden for the current user or entity; in that case,
       the main action is rendered as a regular item, without the submenu #}
    <twig:ea:ActionMenu:ActionList:Item
        class="{{ group.mainAction.cssClass }} dropdown-item-variant-{{ group.mainAction.color.value }}"
        label="{{ group.mainAction.label is ea_is_not_empty ? group.mainAction.label|trans }}" label:class="action-label" renderLabelRaw
        icon="{{ group.mainAction.icon ?: group.icon }}" icon:class="action-icon"
        htmlAttributes="{{ group.mainAction.htmlAttributes|ea_html_attrs }}"
        url="{{ group.mainAction.linkUrl }}"
        renderAsForm="{{ group.mainAction.isRenderedAsForm }}" />
{% else %}
<li class="dropend dropdown-submenu">
    {% if group.hasMainAction and group.mainAction %}
        {# split dropdown: main action + submenu toggle. The submenu is rendered next to the toggle
           (Bootstrap looks for it there) and it's placed next to the whole item, not next to the toggle #}
        <div class="dropend d-flex position-relative">
            <twig:ea:ActionMenu:ActionList:Item
                :wrapInListItem="false"
                class="flex-grow-1 border-end-0 {{ group.mainAction.cssClass }}"
                label="{{ group.mainAction.label is ea_is_not_empty ? group.mainAction.label|trans }}"
                icon="{{ group.icon }}"
                htmlAttributes="{{ group.mainAction.htmlAttributes|ea_html_attrs }}"
                url="{{ group.mainAction.linkUrl }}"
                renderAsForm="{{ group.mainAction.isRenderedAsForm }}" />
            <a class="dropdown-toggle dropdown-toggle-split dropdown-item border-start-0" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-reference="parent" aria-haspopup="true" aria-expanded="false" aria-label="{{ 'action.toggle_dropdown'|trans(domain: 'EasyAdminBundle') }}">
                <twig:ea:Icon name="internal:chevron-right" class="dropdown-submenu-chevron" />
            </a>
            {{ submenu }}
        </div>
    {% else %}
        {# regular submenu toggle #}
        <a class="dropdown-item dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">
            {% if group.icon %}
                <twig:ea:Icon name="{{ group.icon }}" />
            {% endif %}
            {% if group.label is ea_is_not_empty %}<span>{{ group.label|trans }}</span>{% endif %}
            <twig:ea:Icon name="internal:chevron-right" class="dropdown-submenu-chevron" />
        </a>
        {{ submenu }}
    {% endif %}
</li>
{% endif %}
