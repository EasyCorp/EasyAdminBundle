{#
    Button that closes the Modal it lives in. Wraps `<twig:ea:Button>` and adds the
    Bootstrap `data-bs-dismiss="modal"` attribute, so callers don't have to remember
    it. The label goes in the default slot; any other Button prop (variant, icon,
    size, …) is forwarded.

    Usage (inside a footer block): <twig:ea:Modal:Close>Cancel</twig:ea:Modal:Close>
#}
{% props
    ## string The `type` attribute of the button.
    type = 'button',
%}
<twig:ea:Button type="{{ type }}" data-bs-dismiss="modal" {{ ...attributes }}>{{ block(outerBlocks.content) }}</twig:ea:Button>
