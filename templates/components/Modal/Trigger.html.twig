{#
    Button that opens a Modal. Wraps `<twig:ea:Button>` and adds the Bootstrap
    attributes needed to open the target modal, so callers don't have to remember
    `data-bs-toggle`/`data-bs-target`. The label goes in the default slot; any other
    Button prop (variant, icon, size, …) is forwarded.

    Usage: <twig:ea:Modal:Trigger target="#my-modal" variant="primary">Open</twig:ea:Modal:Trigger>
#}
{% props
    ## string The CSS selector of the modal to open (e.g. `#delete-modal`).
    target,
    ## string The `type` attribute of the button.
    type = 'button',
%}
<twig:ea:Button type="{{ type }}" data-bs-toggle="modal" data-bs-target="{{ target }}" {{ ...attributes }}>{{ block(outerBlocks.content) }}</twig:ea:Button>
