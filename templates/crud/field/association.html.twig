{% types {
    field: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\FieldDto',
    entity: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\EntityDto',
} %}
{% if 'toMany' == field.customOptions.get('associationType') %}
    <twig:ea:Badge color="secondary">{{ field.formattedValue }}</twig:ea:Badge>
{% else %}
    {% if field.customOptions.get('relatedUrl') is not null %}
        <a href="{{ field.customOptions.get('relatedUrl') }}">{{ field.formattedValue }}</a>
    {% else %}
        {{ field.formattedValue }}
    {% endif %}
{% endif %}
