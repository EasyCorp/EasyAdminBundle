{% types {
    field: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\FieldDto',
    entity: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\EntityDto',
} %}
{# choice labels are printed as HTML only when ChoiceConfigurator created them and the field doesn't escape them (other fields can use this template too) #}
{% set is_safe_html = field.customOptions.get('formattedValueIsSafeHtml') is same as(true) %}
{% if field.formattedValue is iterable and (field.formattedValue.isRenderedAsBadge ?? false) is same as(true) %}
    {%- for choice in field.formattedValue -%}
        <twig:ea:Badge color="{{ choice.variant }}" variant="{{ field.customOptions.get('badgeVariant') }}">{{ is_safe_html ? choice.message|trans|raw : choice.message|trans }}</twig:ea:Badge>
    {%- endfor -%}
{% elseif is_safe_html %}
    {{ field.formattedValue|trans|raw }}
{% else %}
    {{ field.formattedValue|trans }}
{% endif %}
