{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
{# choice labels are printed as HTML only when ChoiceConfigurator created them (other fields can use this template too) #}
{% if field.customOptions.get('formattedValueIsSafeHtml') is same as(true) %}
    {{ field.formattedValue|trans|raw }}
{% else %}
    {{ field.formattedValue|trans }}
{% endif %}
