{% types {
    field: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\FieldDto',
    entity: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\EntityDto',
} %}
{% if field.customOptions.get('showCode') %}
    <twig:ea:Badge color="currency" variant="{{ field.customOptions.get('badgeVariant') }}" title="{{ field.formattedValue.name }}">{{ field.value }}</twig:ea:Badge>
{% endif %}
{% if field.customOptions.get('showSymbol') %}
    <twig:ea:Badge color="currency" variant="{{ field.customOptions.get('badgeVariant') }}" title="{{ field.formattedValue.name }}">{{ field.formattedValue.symbol }}</twig:ea:Badge>
{% endif %}
{% if field.customOptions.get('showName') %}
    {{ field.formattedValue.name }}
{% endif %}
