{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
{% if field.customOptions.get('showCode') %}
    <twig:ea:Badge color="currency" title="{{ field.formattedValue.name }}">{{ field.value }}</twig:ea:Badge>
{% endif %}
{% if field.customOptions.get('showSymbol') %}
    <twig:ea:Badge color="currency" title="{{ field.formattedValue.name }}">{{ field.formattedValue.symbol }}</twig:ea:Badge>
{% endif %}
{% if field.customOptions.get('showName') %}
    {{ field.formattedValue.name }}
{% endif %}
