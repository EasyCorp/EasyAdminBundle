{% types {
    field: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\FieldDto',
    entity: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\EntityDto',
} %}
{% if field.customOptions.get('showCode') %}
    <twig:ea:Badge color="language" title="{{ field.formattedValue }}">{{ field.value }}</twig:ea:Badge>
{% endif %}
{% if field.customOptions.get('showName') %}
    {{ field.formattedValue ?? '' }}
{% endif %}
