{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
{# this is the default template of all fields, so the value is only printed as HTML
   when the code that formatted it marked it as safe (e.g. TextConfigurator escapes it) #}
{% set is_safe_html = field.customOptions.get('formattedValueIsSafeHtml') is same as(true) %}
{% if ea().crud.currentAction == 'detail' %}
    <span title="{{ field.value }}">{% if is_safe_html %}{{ field.formattedValue|raw|nl2br }}{% else %}{{ field.formattedValue|nl2br }}{% endif %}</span>
{% else %}
    <span title="{{ field.value }}">{% if is_safe_html %}{{ field.formattedValue|raw }}{% else %}{{ field.formattedValue }}{% endif %}</span>
{% endif %}
