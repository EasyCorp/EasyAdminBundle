{% types {
    field: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\FieldDto',
    entity: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\EntityDto',
} %}
{% set render_as_html = field.customOptions.get('renderAsHtml') %}
{% if ea().crud.currentAction == 'detail' %}
    <span title="{{ field.value }}">
        {{ render_as_html ? field.formattedValue|raw : field.formattedValue|raw|nl2br }}
    </span>
{% else %}
    <span title="{{ field.value }}">
        {{ field.formattedValue|raw }}
    </span>
{% endif %}
