{# Colors
   Use the color to tell what the label means: success for things that went
   well, danger for problems, warning for things that need attention, etc. #}
<twig:ea:Badge color="success">Paid</twig:ea:Badge>
<twig:ea:Badge color="warning">Pending</twig:ea:Badge>
<twig:ea:Badge color="danger">Refunded</twig:ea:Badge>
<twig:ea:Badge color="info">Shipped</twig:ea:Badge>
<twig:ea:Badge color="primary">New</twig:ea:Badge>
<twig:ea:Badge color="secondary">Draft</twig:ea:Badge>
<twig:ea:Badge color="light">Archived</twig:ea:Badge>
<twig:ea:Badge color="dark">Internal</twig:ea:Badge>
