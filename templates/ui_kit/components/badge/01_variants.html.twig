{# Variants
   Use the variant to tell what the label means: success for things that went
   well, danger for problems, warning for things that need attention, etc. #}
<twig:ea:Badge variant="success">Paid</twig:ea:Badge>
<twig:ea:Badge variant="warning">Pending</twig:ea:Badge>
<twig:ea:Badge variant="danger">Refunded</twig:ea:Badge>
<twig:ea:Badge variant="info">Shipped</twig:ea:Badge>
<twig:ea:Badge variant="primary">New</twig:ea:Badge>
<twig:ea:Badge variant="secondary">Draft</twig:ea:Badge>
<twig:ea:Badge variant="light">Archived</twig:ea:Badge>
<twig:ea:Badge variant="dark">Internal</twig:ea:Badge>
<twig:ea:Badge variant="outline">Optional</twig:ea:Badge>
