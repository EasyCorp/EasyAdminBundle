{# Custom colors
   Any other color name is rendered as a badge-{color} CSS class (here,
   badge-vip). The theme doesn't style it, so add the CSS for it in your app
   (e.g. define the --badge-tone, --badge-color and --badge-solid-color properties). #}
<twig:ea:Badge color="vip">VIP customer</twig:ea:Badge>
