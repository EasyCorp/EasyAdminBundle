{# Variants
   Use the primary variant for the main action of the page and the default
   variant for the rest. Use danger for actions that delete or can't be undone. #}
<twig:ea:Button type="button">Cancel</twig:ea:Button>
<twig:ea:Button variant="primary" type="button">Save changes</twig:ea:Button>
<twig:ea:Button variant="success" type="button">Approve</twig:ea:Button>
<twig:ea:Button variant="warning" type="button">Suspend account</twig:ea:Button>
<twig:ea:Button variant="danger" type="button">Delete</twig:ea:Button>
<twig:ea:Button variant="info" type="button">View report</twig:ea:Button>
