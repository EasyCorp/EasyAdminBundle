{# Solid
   A solid background. Use it for the main action of the page (with the primary
   color) and to confirm destructive actions (with the danger color). #}
<twig:ea:Button variant="solid" type="button">Default</twig:ea:Button>
<twig:ea:Button variant="solid" color="primary" type="button">Primary</twig:ea:Button>
<twig:ea:Button variant="solid" color="success" type="button">Success</twig:ea:Button>
<twig:ea:Button variant="solid" color="warning" type="button">Warning</twig:ea:Button>
<twig:ea:Button variant="solid" color="danger" type="button">Danger</twig:ea:Button>
<twig:ea:Button variant="solid" color="info" type="button">Info</twig:ea:Button>
