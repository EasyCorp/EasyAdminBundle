{# Outline
   Only a border; the background appears when hovering the button. It's the style
   of the regular actions of the backend. #}
<twig:ea:Button variant="outline" type="button">Default</twig:ea:Button>
<twig:ea:Button variant="outline" color="primary" type="button">Primary</twig:ea:Button>
<twig:ea:Button variant="outline" color="success" type="button">Success</twig:ea:Button>
<twig:ea:Button variant="outline" color="warning" type="button">Warning</twig:ea:Button>
<twig:ea:Button variant="outline" color="danger" type="button">Danger</twig:ea:Button>
<twig:ea:Button variant="outline" color="info" type="button">Info</twig:ea:Button>
