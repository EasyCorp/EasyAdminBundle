{# Ghost
   No background or border until you hover the button. Use it for actions that
   shouldn't get much attention, such as the delete action of each row. #}
<twig:ea:Button variant="ghost" icon="internal:edit" type="button">Edit</twig:ea:Button>
<twig:ea:Button variant="ghost" color="primary" type="button">Primary</twig:ea:Button>
<twig:ea:Button variant="ghost" color="danger" icon="internal:delete" type="button">Delete</twig:ea:Button>
<twig:ea:Button variant="ghost" icon="internal:xmark" aria-label="Close" type="button" />
