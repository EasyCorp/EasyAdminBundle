{# Icons
   The icon is displayed before the label. Use withTrailingIcon to display it
   after the label. Buttons without label need an aria-label to be accessible. #}
<twig:ea:Button variant="primary" icon="internal:plus" type="button">Add product</twig:ea:Button>
<twig:ea:Button icon="internal:download" type="button">Export</twig:ea:Button>
<twig:ea:Button icon="internal:chevron-right" withTrailingIcon type="button">Next step</twig:ea:Button>
<twig:ea:Button icon="internal:gear" aria-label="Settings" type="button" />
