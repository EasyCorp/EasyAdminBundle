{# Invisible
   Invisible buttons don't show a background or border until you hover them.
   They are useful for secondary actions that shouldn't get much attention. #}
<twig:ea:Button isInvisible icon="internal:edit" type="button">Edit</twig:ea:Button>
<twig:ea:Button isInvisible icon="internal:xmark" aria-label="Close" type="button" />
