{# Forms
   Set htmlElement to "form" to render the button inside its own form. Use it for
   actions that change data. Methods other than GET and POST are sent in the
   _method field (this needs the http_method_override option of Symfony). #}
<twig:ea:Button htmlElement="form" action="#" method="DELETE" variant="danger" icon="internal:delete">Delete order</twig:ea:Button>
