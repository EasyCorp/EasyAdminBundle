{# Title and contents
   A card groups related contents in a box with an optional header. Put the
   contents in the content block; the header is only displayed when the card
   has a title, an icon, a help message, a link or some actions. #}
<twig:ea:Card title="Shipping address">
    <twig:block name="content">
        Anna Smith, 42 Market Street, Springfield, United States
    </twig:block>
</twig:ea:Card>
