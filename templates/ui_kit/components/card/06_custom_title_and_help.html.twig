{# Custom title and help
   The title, help and link_label blocks replace the props with the same name
   and can contain HTML (the props are always escaped). #}
<twig:ea:Card linkUrl="#">
    <twig:block name="title">Pending reviews <twig:ea:Badge color="warning" size="sm">7 new</twig:ea:Badge></twig:block>
    <twig:block name="help">Reviews are published after <strong>a moderator</strong> approves them.</twig:block>
    <twig:block name="link_label">Moderate</twig:block>
    <twig:block name="content">The oldest review is 2 days old.</twig:block>
</twig:ea:Card>
