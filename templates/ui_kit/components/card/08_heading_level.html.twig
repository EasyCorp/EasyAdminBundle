{# Heading level
   The title is an h3 element by default. Change its level so the headings of the
   page keep a logical order (e.g. h2 for cards that aren't inside any section). #}
<twig:ea:Card title="Store settings" :headingLevel="2" titleId="ui-kit-card-store-settings">
    <twig:block name="content">
        Currency, time zone and tax rules of the store.
    </twig:block>
</twig:ea:Card>
