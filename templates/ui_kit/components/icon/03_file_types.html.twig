{# File type icons
   Use the filetypes: prefix to display the icon of a type of file. Icons are as
   big as the font size of their text, so change the font size to resize them. #}
<twig:ea:Icon name="filetypes:pdf" style="font-size: 32px" />
<twig:ea:Icon name="filetypes:spreadsheet" style="font-size: 32px" />
<twig:ea:Icon name="filetypes:image" style="font-size: 32px" />
<twig:ea:Icon name="filetypes:zip" style="font-size: 32px" />
<twig:ea:Icon name="filetypes:video" style="font-size: 32px" />
