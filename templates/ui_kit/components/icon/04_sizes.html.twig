{# Sizes
   Without a size, icons are as big as their text (14px by default). Use the size
   prop to apply the icon sizes of the theme: sm (16px), md (20px) and lg (24px).
   It works with any icon set. #}
<twig:ea:Icon name="fa-solid fa-user" size="sm" />
<twig:ea:Icon name="fa-solid fa-user" size="md" />
<twig:ea:Icon name="fa-solid fa-user" size="lg" />
