{# Compact
   Hide the page numbers or the labels of the previous and next links when
   there's not much space. #}
<twig:ea:Pagination :currentPage="4" :lastPage="12" urlPattern="?page={page}" :showPageNumbers="false" />
<twig:ea:Pagination :currentPage="4" :lastPage="12" urlPattern="?page={page}" :showPreviousNextLabels="false" />
