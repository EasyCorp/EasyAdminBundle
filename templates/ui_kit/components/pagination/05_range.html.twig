{# Number of page links
   rangeSize is the number of links around the current page and rangeEdgeSize
   the number of links at the beginning and the end. #}
<twig:ea:Pagination :currentPage="50" :lastPage="100" urlPattern="?page={page}" :rangeSize="1" :rangeEdgeSize="1" />
<twig:ea:Pagination :currentPage="50" :lastPage="100" urlPattern="?page={page}" :rangeSize="3" :rangeEdgeSize="2" />
