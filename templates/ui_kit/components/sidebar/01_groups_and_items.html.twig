{# Groups and items
   These are the parts of the main menu of the dashboard (the Sidebar component
   is the left column of the page that contains it). The badge block of the
   items displays extra information. #}
<twig:ea:Sidebar:Group label="Sales" icon="internal:folder-open">
    <twig:ea:Sidebar:Item label="Orders" href="#" icon="internal:file-lines" active>
        <twig:block name="badge"><twig:ea:Badge variant="primary" size="sm">12</twig:ea:Badge></twig:block>
    </twig:ea:Sidebar:Item>
    <twig:ea:Sidebar:Item label="Invoices" href="#" icon="internal:detail" />
    <twig:ea:Sidebar:Item label="Customers" href="#" icon="internal:user" />
</twig:ea:Sidebar:Group>
