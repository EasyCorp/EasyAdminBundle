{# Submenus
   Items with hasSubmenu toggle the submenu defined in their submenu block. #}
<twig:ea:Sidebar:Group label="Catalog">
    <twig:ea:Sidebar:Item label="Products" icon="internal:folder-open" hasSubmenu expanded>
        <twig:block name="submenu">
            <twig:ea:Sidebar:Submenu label="Products">
                <twig:ea:Sidebar:Item label="All products" href="#" active />
                <twig:ea:Sidebar:Item label="Categories" href="#" />
                <twig:ea:Sidebar:Item label="Brands" href="#" />
            </twig:ea:Sidebar:Submenu>
        </twig:block>
    </twig:ea:Sidebar:Item>
    <twig:ea:Sidebar:Item label="Settings" href="#" icon="internal:gear" />
</twig:ea:Sidebar:Group>
