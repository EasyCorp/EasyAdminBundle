{# Variants
   The variant changes the color of the switch when it's on. #}
<twig:ea:Switch ariaLabel="Default" checked />
<twig:ea:Switch ariaLabel="Success" variant="success" checked />
<twig:ea:Switch ariaLabel="Warning" variant="warning" checked />
<twig:ea:Switch ariaLabel="Danger" variant="danger" checked />
