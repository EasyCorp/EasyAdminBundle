    <twig:ea:Sidebar:Group label="Sales" icon="internal:folder-open">
        <twig:ea:Sidebar:Item label="Orders" href="#" icon="internal:file-lines" active />
        <twig:ea:Sidebar:Item label="Invoices" href="#" icon="internal:detail" />
        <twig:ea:Sidebar:Item label="Customers" href="#" icon="internal:user" />
